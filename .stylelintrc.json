{
  "customSyntax": "postcss-scss",
  "overrides": [
    {
      "files": ["**/*.scss"],
      "extends": ["stylelint-config-standard-scss"]
    }
  ],
  "rules": {
    "selector-pseudo-element-no-unknown": [
      true,
      {
        "ignorePseudoElements": ["ng-deep"]
      }
    ],
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "use",
          "mixin",
          "include",
          "if",
          "else",
          "layer",
          "responsive",
          "screen",
          "variants"
        ]
      }
    ]
  }
}
