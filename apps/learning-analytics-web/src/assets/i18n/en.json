    "DESCRIPTION": {
      "ALL_USERS": "List of users who have access to Konquest. <br> <b>Fields :</b><ul> <li> User ID </li> <li> User Name </li> <li> User Email </li> <li> User phone </li> <li> User address </li> </ul>",
      "COURSE_OVERVIEW": "General statistics of a Konquest course with summarized information about contents, enrollments, courses (courses), pulses and quizzes. <br> <ul> <li> Contents: total hours, punctuation, evaluation and distribution by type. </li> <li> Enrollments: completed, progress and comparison in the last 7 and 30 days. </li> <li> Performance: evaluation of users' performances by tracks </li> <li> Performance of Quizzes: evaluation of performance quizzes </li> <li> Quizzes: analysis of mistakes and successes </li> <li> Ranking: 10 best performances in the course </li> </ul>",
      "GROUP_CHANNEL_USER": "List of the relationship of channels, groups and users with 'raw' data (without treatments) and with summary tables and dashboards. <br> <b>Fields:</b><ul> <li> Group name </li> <li> Channel name </li> <li> User name </li> <li> User email </li> </ul>",
      "GROUP_MISSION_USER": "List of the relationship of courses, groups and users with 'raw' data (without treatments) and with summary tables and dashboards. <br> <b>Fields:</b><ul> <li> Group name </li> <li> Course name </li> <li> User name </li> <li> User email </li> </ul>",
      "MISSION_ENROLLMENTS": "General list of enrollments for all courses with 'raw' data (without treatments) and with summary tables and dashboard. <br> <b>Fields:</b><ul> <li> Course ID </li> <li> Course name </li> <li> Owner user (creator) </li> <li> Last updated date </li> <li> Creation status </li> <li> Course type </li> <li> Group Name </li> <ul>",
      "MISSION_EVALUATIONS": "Description of Course Evaluations",
      "MISSION_QUIZ": "General list of quizzes for all courses with 'raw' data (without treatments) and summary tables and dashboards. <br> <b>Fields:</b><ul> <li> Answer ID </li> <li> Course Name </li> <li> User </li> <li> Question </li> <li> Hit </li> <li> Response Date </li> </ul>",
      "PULSES_ACTIVITIES": "List of channels and pulses with the users' consumption activities, the data being 'raw' (without treatments), with summarized tables and dashboard. <br> <b>Fields:</b><ul> <li> Name Channel </li> <li> Pulse name </li> <li> Consumer user name </li> <li> Consumer user email </li> <li> Action </li> <li> Date start </li> <li> End date </li> <li> Consumption </li> </ul>",
      "PULSES_QUIZ": "List of quizzes by channels and pulses with the activities of the users, the data being 'raw' (without treatments), with summarized tables and dashboard. <br> <b>Fields:</b><ul> <li> ID answer </li> <li> Pulse name </li> <li> User name </li> <li> User email </li> <li> Question </li> <li> Hit </li> <li> Reply Date </li> </ul>",
      "PULSE_CHANNELS": "List of channels and pulses with 'raw' data (without treatments) and with summary tables and dashboards. <br> <b>Fields:</b><ul> <li> Name of Pulse </li> <li> Pulse Type </li> <li> Pulse Duration </li> <li> Channel Name </li> <li> Channel Type </li> <li> Owner User (Creator) </li> </ul>",
      "USERS_ACCESS": "List of daily active users (who used Konquest to consume some content). <br> <b>Fields:</b><ul> <li> User name </li> <li> User email </li> <li> User Phone </li> <li> Activity Date </li> <li> Last Access </li> <li> Last Activity </li> </ul>",
      "USER_OVERVIEW": "General statistics of a user in Konquest with summarized information on enrollments, content consumed, accesses and level of engagement. <br> <ul> <li> Summary of course consumption (completion rates) </li> <li> List of completed courses (with performance) \n </li> <li> List of consumed pulses (with consumption time) </li> <li> Link relationship with groups (with completion rates) </li> </ul>",
      "WORKSPACE_MISSION": "General list of courses with 'raw' data (without treatments) and summary tables and dashboard. <br> <b>Fields:</b><ul> <li> Course ID </li> <li> Name course </li> <li> Owner user (creator) </li> <li> Last updated date </li> <li> Creation date </li> <li> Course status (in creation, published or under review) </li> <li> Type of course (public or private) </li> <li> Group linked to the course (ID, Name) </li> <li> Duration of the course </li> <li> Total enrollments </li> <li> Total enrollments completed </li> <li> Course category </li> </ul>",
      "WORKSPACE_OVERVIEW": "General Konquest statistics with summary information on content, enrollments, courses (courses) and pulses."
    },
