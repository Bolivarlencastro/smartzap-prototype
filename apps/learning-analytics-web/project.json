{
  "name": "learning-analytics-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/learning-analytics-web/src",
  "prefix": "app",
  "implicitDependencies": ["!tailwind-preset"],
  "targets": {
    "build": {
      "executor": "@nx/angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "plugins": ["kp-version.plugin.js"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared-ui/layout/src/lib", "libs/shared-ui/ui", ""]
        },
        "outputPath": "dist/apps/learning-analytics-web",
        "index": "apps/learning-analytics-web/src/index.html",
        "main": "apps/learning-analytics-web/src/main.ts",
        "polyfills": "apps/learning-analytics-web/src/polyfills.ts",
        "tsConfig": "apps/learning-analytics-web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/learning-analytics-web/src/assets"],
        "styles": [
          "libs/shared-ui/layout/src/lib/styles/tailwind.scss",
          "libs/shared-ui/layout/src/lib/styles/main.scss",
          "apps/learning-analytics-web/src/app/app.theme.scss"
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "@messageformat",
          "@jsverse",
          "canvg",
          "core-js",
          "deep-freeze-strict",
          "faker",
          "iv-viewer",
          "jspdf",
          "jspdf-autotable",
          "keycloak-js",
          "raf",
          "rgbcolor"
        ],
        "serviceWorker": true,
        "ngswConfigPath": "apps/learning-analytics-web/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/learning-analytics-web/src/environments/environment.ts",
              "with": "apps/learning-analytics-web/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "5mb",
              "maximumError": "10mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "learning-analytics-web:build:production"
        },
        "development": {
          "buildTarget": "learning-analytics-web:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/learning-analytics-web"],
      "options": {
        "jestConfig": "apps/learning-analytics-web/jest.config.ts",
        "ci": true,
        "codeCoverage": true,
        "tsConfig": "apps/learning-analytics-web/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "cache": false
        },
        "dev": {
          "coverageReporters": ["html", "text-summary", "lcov"]
        }
      },
      "defaultConfiguration": "dev"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/learning-analytics-web/**/*.scss"]
      }
    },
    "i18n-extract": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "transloco-keys-manager extract --project learning-analytics-web"
      }
    },
    "i18n:find": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "transloco-keys-manager find --project learning-analytics-web"
      }
    },
    "sonar": {
      "executor": "@koliveira15/nx-sonarqube:scan",
      "options": {
        "name": "Learning Analytics Web",
        "hostUrl": "https://steve.keepsdev.com/sonar/",
        "projectKey": "learning-analytics-web",
        "skipTargetDefaults": false,
        "branches": false,
        "qualityGate": true,
        "qualityGateTimeout": "300",
        "skipImplicitDeps": false,
        "exclusions": "**/libs/**",
        "extra": {
          "sonar.testExecutionReportPaths": "coverage/learning-analytics-web/jest-sonar.xml",
          "sonar.coverage.exclusions": "**/store/**, **/translate.ts, **/*.routes.ts, **/app.config.ts,, **/*.module.ts, **/app.component.ts, **/test-setup.ts, src/main.ts",
          "sonar.plugins.downloadOnlyRequired": "true"
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "learning-analytics-web:build"
      }
    }
  }
}
