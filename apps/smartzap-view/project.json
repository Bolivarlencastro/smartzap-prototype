{
  "name": "smartzap-view",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/smartzap-view/src",
  "prefix": "app",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "plugins": ["kp-version.plugin.js"],
        "outputPath": "dist/apps/smartzap-view",
        "index": "apps/smartzap-view/src/index.html",
        "main": "apps/smartzap-view/src/main.ts",
        "polyfills": "apps/smartzap-view/src/polyfills.ts",
        "tsConfig": "apps/smartzap-view/tsconfig.app.json",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared-ui/ui", ""]
        },
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/smartzap-view/src/favicon.png",
          "apps/smartzap-view/src/assets",
          {
            "glob": "**/*",
            "input": "./node_modules/ngx-extended-pdf-viewer/assets/",
            "output": "/assets/"
          }
        ],
        "styles": [
          "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
          "./node_modules/iv-viewer/dist/iv-viewer.min.css",
          "./node_modules/vidstack/player/styles/default/theme.css",
          "./node_modules/vidstack/player/styles/default/layouts/video.css",
          "./node_modules/vidstack/player/styles/default/layouts/audio.css",
          "apps/smartzap-view/src/app/app.theme.scss",
          "apps/smartzap-view/src/styles.scss"
        ],
        "scripts": ["./node_modules/iv-viewer/dist/iv-viewer.min.js"],
        "allowedCommonJsDependencies": [
          "@messageformat",
          "@jsverse",
          "canvag",
          "core-js",
          "iv-viewer",
          "jspdf",
          "jspdf-autotable",
          "keycloak-js",
          "raf",
          "rgbcolor"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "100kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/smartzap-view/src/environments/environment.ts",
              "with": "apps/smartzap-view/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/smartzap-view/src/environments/environment.ts",
              "with": "apps/smartzap-view/src/environments/environment.hml.ts"
            }
          ],
          "buildOptimizer": false,
          "optimization": false,
          "sourceMap": true,
          "namedChunks": true,
          "extractLicenses": false
        },
        "prototype": {
          "fileReplacements": [
            {
              "replace": "apps/smartzap-view/src/environments/environment.ts",
              "with": "apps/smartzap-view/src/environments/environment.prototype.ts"
            }
          ],
          "buildOptimizer": false,
          "optimization": false,
          "sourceMap": true,
          "namedChunks": true,
          "extractLicenses": false
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "smartzap-view:build:production"
        },
        "development": {
          "buildTarget": "smartzap-view:build:development"
        },
        "prototype": {
          "buildTarget": "smartzap-view:build:prototype"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/smartzap-view"],
      "options": {
        "jestConfig": "apps/smartzap-view/jest.config.ts",
        "ci": true,
        "codeCoverage": true,
        "tsConfig": "apps/smartzap-view/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "cache": false
        },
        "dev": {
          "coverageReporters": ["html", "text-summary", "lcov"]
        }
      },
      "defaultConfiguration": "dev"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/smartzap-view/**/*.scss"]
      }
    },
    "sonar": {
      "executor": "@koliveira15/nx-sonarqube:scan",
      "options": {
        "name": "Smartzap View Web",
        "hostUrl": "https://steve.keepsdev.com/sonar/",
        "projectKey": "smartzap-view-web",
        "skipTargetDefaults": false,
        "branches": false,
        "qualityGate": true,
        "qualityGateTimeout": "300",
        "skipImplicitDeps": false,
        "exclusions": "**/libs/**",
        "extra": {
          "sonar.testExecutionReportPaths": "coverage/smartzap-view/jest-sonar.xml",
          "sonar.coverage.exclusions": "**/store/**, **/translate.ts, **/*.routes.ts, **/app.config.ts,, **/*.module.ts, **/app.component.ts, **/test-setup.ts, src/main.ts",
          "sonar.plugins.downloadOnlyRequired": "true"
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "smartzap-view:build"
      }
    }
  }
}
