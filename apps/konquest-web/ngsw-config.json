{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/runtime*.js",
          "/polyfills*.js",
          "/main*.js",
          "/styles*.css"
        ]
      }
    },
    {
      "name": "lazy-bundles",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.js", "!/runtime*.js", "!/polyfills*.js", "!/main*.js", "/*.css", "!/styles*.css"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
