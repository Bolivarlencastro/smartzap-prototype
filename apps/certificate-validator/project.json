{
  "name": "certificate-validator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "cv",
  "sourceRoot": "apps/certificate-validator/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "plugins": ["kp-version.plugin.js"],
        "index": "apps/certificate-validator/src/index.html",
        "main": "apps/certificate-validator/src/main.ts",
        "outputPath": "dist/apps/certificate-validator",
        "polyfills": "apps/certificate-validator/src/polyfills.ts",
        "tsConfig": "apps/certificate-validator/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared-ui/ui", ""]
        },
        "assets": ["apps/certificate-validator/src/assets"],
        "styles": [
          "libs/shared-ui/layout/src/lib/styles/tailwind.scss",
          "libs/shared-ui/layout/src/lib/styles/main.scss",
          "apps/certificate-validator/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/certificate-validator/src/environments/environment.ts",
              "with": "apps/certificate-validator/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "certificate-validator:build:production"
        },
        "development": {
          "buildTarget": "certificate-validator:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "certificate-validator:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/certificate-validator"],
      "options": {
        "jestConfig": "apps/certificate-validator/jest.config.ts",
        "tsConfig": "apps/certificate-validator/tsconfig.spec.json",
        "ci": true,
        "codeCoverage": true
      },
      "configurations": {
        "ci": {
          "cache": false
        },
        "dev": {
          "coverageReporters": ["html", "text-summary", "lcov"]
        }
      },
      "defaultConfiguration": "dev"
    },
    "sonar": {
      "executor": "@koliveira15/nx-sonarqube:scan",
      "options": {
        "name": "Certificate Validator Web",
        "hostUrl": "https://steve.keepsdev.com/sonar/",
        "projectKey": "certificate-validator-web",
        "skipTargetDefaults": false,
        "branches": false,
        "qualityGate": true,
        "qualityGateTimeout": "300",
        "skipImplicitDeps": false,
        "exclusions": "**/libs/**",
        "extra": {
          "sonar.testExecutionReportPaths": "coverage/certificate-validator/jest-sonar.xml",
          "sonar.coverage.exclusions": "**/store/**, **/translate.ts, **/*.routes.ts, **/app.config.ts,, **/*.module.ts, **/app.component.ts, **/test-setup.ts, src/main.ts",
          "sonar.plugins.downloadOnlyRequired": "true",
          "sonar.cpd.exclusions": "apps/certificate-validator/src/environments/*"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "certificate-validator:build",
        "staticFilePath": "dist/apps/certificate-validator/browser",
        "spa": true
      }
    }
  }
}
