{
  "name": "shared-ui-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/shared-ui/ui/src",
  "prefix": "kp",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared-ui/ui/jest.config.ts",
        "ci": true,
        "codeCoverage": true,
        "tsConfig": "libs/shared-ui/ui/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "cache": false
        },
        "dev": {
          "coverageReporters": ["html", "text-summary", "lcov"]
        }
      },
      "defaultConfiguration": "dev"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/shared-ui/ui/**/*.scss"]
      }
    },
    "i18n-extract": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "transloco-keys-manager extract --project ui"
      }
    },
    "i18n:find": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "transloco-keys-manager find --project ui"
      }
    },
    "sonar": {
      "executor": "@koliveira15/nx-sonarqube:scan",
      "options": {
        "name": "Ui Web",
        "hostUrl": "https://steve.keepsdev.com/sonar/",
        "projectKey": "ui-web",
        "skipTargetDefaults": false,
        "branches": false,
        "qualityGate": true,
        "qualityGateTimeout": "300",
        "skipImplicitDeps": false,
        "exclusions": "libs/core/**, libs/shared-ui/layout/**, libs/shared-ui/tailwind-preset/**",
        "extra": {
          "sonar.coverage.exclusions": "libs/shared-ui/layout/**, libs/shared-ui/tailwind-preset/**, **/*.stories.ts, **/test-setup.ts",
          "sonar.testExecutionReportPaths": "coverage/shared-ui-ui/jest-sonar.xml",
          "sonar.plugins.downloadOnlyRequired": "true"
        }
      }
    }
  }
}
