{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "emitDecoratorMetadata": false,
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "isolatedModules": true,
    "target": "es2016",
    "types": ["jest", "node"],
    "moduleResolution": "bundler"
  },
  "files": ["src/test-setup.ts"],
  "include": ["jest.config.ts", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
